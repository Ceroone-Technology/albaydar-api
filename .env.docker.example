# Copia este archivo como .env (junto a docker-compose.yml) para cambiar valores.
# Todos son opcionales: sin .env, `docker compose up` funciona con los de por defecto
# (los correos se quedan en Mailpit, http://localhost:8025).

# ── Puertos en tu máquina ───────────────────────────────────
API_PORT=3000
DB_PORT=5432
MAILPIT_WEB_PORT=8025
MAILPIT_SMTP_PORT=1025

# ── Base de datos ───────────────────────────────────────────
POSTGRES_USER=albaydar
POSTGRES_PASSWORD=albaydar
POSTGRES_DB=albaydar

# ── Front Angular ───────────────────────────────────────────
CORS_ORIGINS=http://localhost:4200
PUBLIC_APP_URL=http://localhost:4200

# ── Seguridad (obligatorio cambiarlo fuera de tu máquina) ───
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=

# ── Datos iniciales ─────────────────────────────────────────
RUN_SEED=true
SEED_DEMO=true
# Usuario de Dirección (superadministrador) que se crea la primera vez
SEED_ADMIN_EMAIL=admin@albaydar.org
SEED_ADMIN_PASSWORD=CambiaEsto-2026!

# ── Ficheros subidos (boletines de notas) ───────────────────
# Carpeta de TU equipo donde se guardan. Por defecto, ./storage/uploads dentro
# del proyecto. Cuando haya servidor se cambiará a almacenamiento en la nube.
UPLOADS_HOST_DIR=./storage/uploads

# ── Correo: Gmail para la demostración ──────────────────────
# Descomenta este bloque para enviar correos reales con tu Gmail.
# La contraseña NO es la de tu cuenta: es una "contraseña de aplicación" de 16
# letras (ver docs/gmail.md). Llevan el prefijo DOCKER_ para no mezclarse con
# las variables SMTP_* que usa `npm run dev`.
#
# DOCKER_SMTP_HOST=smtp.gmail.com
# DOCKER_SMTP_PORT=465
# DOCKER_SMTP_SECURE=true
# DOCKER_SMTP_USER=tucorreo@gmail.com
# DOCKER_SMTP_PASS=abcdefghijklmnop
# MAIL_FROM=Centro Educativo Albaydar <tucorreo@gmail.com>
#
# Muy recomendable en la demo: TODOS los correos llegan a este buzón (con el
# destinatario real en el asunto). Así nunca se escribe a familias de ejemplo
# que puedan existir de verdad (p. ej. epena@correo.es).
# MAIL_DESVIO=tucorreo@gmail.com
#
# Buzón de secretaría para los avisos internos ("la familia pide otra franja")
# MAIL_SECRETARIA=tucorreo@gmail.com
#
# Buzón de administración para "reserva vencida sin pagar" (si no, solo secretaría)
# MAIL_ADMINISTRACION=tucorreo@gmail.com
