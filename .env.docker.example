# Copia este archivo como .env (junto a docker-compose.yml) para cambiar valores.
# Todos son opcionales: sin .env, `docker compose up` funciona con los de por defecto.

# Puertos en tu máquina
API_PORT=3000
DB_PORT=5432
MAILPIT_WEB_PORT=8025
MAILPIT_SMTP_PORT=1025

# Base de datos
POSTGRES_USER=albaydar
POSTGRES_PASSWORD=albaydar
POSTGRES_DB=albaydar

# Front Angular
CORS_ORIGINS=http://localhost:4200
PUBLIC_APP_URL=http://localhost:4200

# Seguridad (obligatorio cambiarlo fuera de tu máquina)
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=

# Datos iniciales
RUN_SEED=true
SEED_DEMO=true
SEED_ADMIN_EMAIL=admin@albaydar.org
SEED_ADMIN_PASSWORD=CambiaEsto-2026!

# SMTP real (por defecto los correos van a Mailpit). Llevan el prefijo DOCKER_
# para no mezclarse con las variables SMTP_* que usa `npm run dev`.
# DOCKER_SMTP_HOST=smtp.office365.com
# DOCKER_SMTP_PORT=587
# DOCKER_SMTP_USER=
# DOCKER_SMTP_PASS=
