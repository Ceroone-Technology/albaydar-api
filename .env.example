# ── Servidor ────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Orígenes permitidos por CORS (el front Angular), separados por comas
CORS_ORIGINS=http://localhost:4200
# Hay un proxy delante (nginx, balanceador)? Necesario para IP real y rate limit
TRUST_PROXY=false

# ── Base de datos ───────────────────────────────────────────
DATABASE_URL=postgresql://albaydar:albaydar@localhost:5432/albaydar

# ── Autenticación ───────────────────────────────────────────
# Genera cada secreto con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=cambia-esto-por-un-secreto-largo-de-al-menos-32-caracteres
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=14
# true en producción (HTTPS). Con front y API en dominios distintos usa SameSite=none
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# ── Enlaces públicos (páginas Angular sin login) ────────────
# URL base del front; los correos enlazan a /cita/:token y /solicitud/completar/:token
PUBLIC_APP_URL=http://localhost:4200
CITA_TOKEN_TTL_DAYS=14
COMPLETAR_TOKEN_TTL_DAYS=14

# ── Correo (SMTP) ───────────────────────────────────────────
# En local, Mailpit (docker compose) recoge todo en http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Centro Educativo Albaydar <admisiones@albaydar.org>"
# Buzón interno que recibe avisos (familia pide otra franja, reserva vencida)
# Ojo: albaydar.org es el dominio real del centro. Con SMTP real, pon aquí tu buzón.
MAIL_SECRETARIA=secretaria@albaydar.org
# Aviso "reserva vencida sin pagar" también a administración (vacío: solo secretaría)
MAIL_ADMINISTRACION=
# Demos: si se indica, TODOS los correos van a este buzón (con el destinatario real en el asunto)
MAIL_DESVIO=

# ── Reglas del flujo ────────────────────────────────────────
TZ_CENTRO=Europe/Madrid
# Días sin respuesta tras enviar la citación para mandar el recordatorio
RECORDATORIO_CITA_DIAS=3
# Activar los workers de correo y recordatorios en este proceso
WORKERS_ENABLED=true

# ── Usuario administrador inicial (solo lo usa db:seed) ─────
SEED_ADMIN_EMAIL=admin@albaydar.org
SEED_ADMIN_PASSWORD=CambiaEsto-2026!
